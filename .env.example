# arm-copilot 配置（复制一份为 .env 后填写）
# 任何 OpenAI 兼容接口均可，模型名以你的服务商文档为准。

# 智谱 GLM 示例
ARM_COPILOT_API_BASE=https://open.bigmodel.cn/api/paas/v4
ARM_COPILOT_API_KEY=your-api-key
ARM_COPILOT_MODEL=glm-4.6

# DeepSeek 示例
# ARM_COPILOT_API_BASE=https://api.deepseek.com/v1
# ARM_COPILOT_API_KEY=your-api-key
# ARM_COPILOT_MODEL=deepseek-chat

# 阿里 Qwen 示例
# ARM_COPILOT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# ARM_COPILOT_API_KEY=your-api-key
# ARM_COPILOT_MODEL=qwen-plus

# OpenAI 示例
# ARM_COPILOT_API_BASE=https://api.openai.com/v1
# ARM_COPILOT_API_KEY=your-api-key
# ARM_COPILOT_MODEL=gpt-4o-mini

# 置 1 等效于命令行 --mock（模拟执行所有命令，不触碰真实硬件）
# ARM_COPILOT_MOCK=0
